<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything, including the header, so the window has no action bar. -->
    <style name="Theme.Aamp" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- A round, borderless widget button with an icon in the text color. -->
    <style name="WidgetButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/widget_text</item>
    </style>
</resources>
