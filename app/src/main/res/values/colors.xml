<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="launcher_background">#FF1E3A5F</color>
    <!-- The phone screen's background before Compose draws, matching its system palette color. -->
    <color name="window_background">@android:color/system_neutral1_10</color>
    <!-- Home screen widget, from the same system palette as the phone screen. -->
    <color name="widget_background">@android:color/system_accent2_50</color>
    <color name="widget_text">@android:color/system_neutral1_900</color>
    <color name="widget_muted">@android:color/system_neutral2_600</color>
    <color name="widget_placeholder">@android:color/system_neutral2_100</color>
</resources>
